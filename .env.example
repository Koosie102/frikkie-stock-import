# Copy this to .env locally, and set the real values as Railway environment
# variables in the Railway dashboard for production — never commit .env.

SHOPIFY_API_KEY=967712365a20b26ba490d896a343e824
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_inventory,write_inventory,read_online_store_navigation,write_online_store_navigation,read_publications,write_publications
SHOPIFY_APP_URL=https://REPLACE_WITH_RAILWAY_DOMAIN.up.railway.app

# Railway provisions this automatically if you add a Postgres plugin to the
# project — copy its DATABASE_URL reference here (Railway lets you
# reference it as ${{Postgres.DATABASE_URL}}).
DATABASE_URL=

NODE_ENV=production
